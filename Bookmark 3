javascript:(function(){const u="你的_WEB_APP_URL";let s={};document.querySelectorAll(".id").forEach(e=>{let m=e.innerText.match(/CM\s*([A-Za-z0-9-]+)/i);if(m)s[m[1].toUpperCase()]=1});let n=Object.keys(s).length;if(n){fetch(u,{method:"POST",body:JSON.stringify(s),mode:"no-cors"}).then(()=>alert(`✅ 发现${n}个货号！\n已尝试发送到云端。`))}else{alert("❌ 没找到货号，请确认是否在查询结果页")}} )();
